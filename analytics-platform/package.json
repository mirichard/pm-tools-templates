    "@typescript-eslint/parser": "^8.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
