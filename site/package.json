{
  "name": "pm-tools-templates-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "test:e2e": "playwright test",
    "ci": "node server.js & echo $! > .server.pid && npx wait-on http://localhost:5173 && playwright test && lhci autorun --collect.url=http://localhost:5173 && kill $(cat .server.pid) || (kill $(cat .server.pid) || true; exit 1)"
  },
  "dependencies": {
    "express": "^5.2.1",
    "marked": "^18.0.9",
    "highlight.js": "^11.12.0",
    "morgan": "^1.11.0",
    "etag": "^1.8.1",
    "express-rate-limit": "^8.1.0"
  },
  "overrides": {
    "qs": "^6.15.2",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "basic-ftp": "5.3.1",
    "tar-fs": "^3.0.6",
    "nth-check": "^2.1.1",
    "cookie": "^0.7.0",
    "on-headers": "^1.0.2",
    "webpack-dev-server": "^4.15.2",
    "esbuild": "^0.25.0",
    "form-data": "^4.0.0",
    "tmp": "^0.2.6",
    "@puppeteer/browsers": "3.2.0",
    "@lhci/cli": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "lighthouse": "^13.4.1",
    "@lhci/cli": "^0.15.1",
    "wait-on": "^9.1.0"
  }
}
