{
  "name": "pm-tools-templates",
  "version": "2.0.0",
  "description": "AI-Powered Project Management Templates with Interactive Onboarding",
  "main": "ecosystem-gateway.js",
  "scripts": {
    "start": "node ecosystem-gateway.js",
    "onboard": "node onboarding/interactive-onboarding.js",
    "test": "echo 'Basic test passed' && exit 0",
    "gateway": "node ecosystem-gateway.js",
    "quick-start": "node onboarding/interactive-onboarding.js",
    "dashboard-demo": "npm --prefix dashboard-mvp run dev",
    "test:migration-post-check": "node --test tests/migration-post-check.test.mjs",
    "validate:migration-post-check": "node scripts/migration-post-check.mjs",
    "validate:domain-navigation": "node scripts/validate-domain-navigation.mjs",
    "test:ci-helpers": "node --test tests/ai-insights-withdrawal.test.mjs tests/coverage-contract.test.mjs tests/ci-coverage-inventory.test.mjs tests/capture.test.mjs tests/run-app-check.test.mjs tests/playwright-webserver-config.test.mjs tests/ci-gate.test.mjs",
    "test:ci-helpers-python": "python3 -m unittest tests.test_workflow_health tests.test_applicability_gate -v"
  },
  "keywords": [
    "project-management",
    "templates",
    "agile",
    "scrum",
    "waterfall",
    "hybrid",
    "onboarding",
    "ai-powered",
    "interactive"
  ],
  "author": "PM Tools Templates Team",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest-axe": "^11.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mirichard/pm-tools-templates.git"
  },
  "homepage": "https://github.com/mirichard/pm-tools-templates#readme",
