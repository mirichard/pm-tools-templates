---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Advanced template browser with previews and version history" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    
    <style>
      /* Tufte-inspired minimal design */
      :root {
        --bg-color: #fffff8;
        --text-color: #111111;
        --accent-color: #0066cc;
        --border-color: #d0d0d0;
        --code-bg: #f8f8f8;
        --shadow-color: rgba(0, 0, 0, 0.1);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg-color: #151515;
          --text-color: #eeeeee;
          --border-color: #333333;
          --code-bg: #1a1a1a;
          --shadow-color: rgba(255, 255, 255, 0.1);
        }
      }

      * {
        box-sizing: border-box;
      }

      html {
        font-family: "et-book", Palatino, "Palatino Linotype", "Palatino LT STD", "Book Antiqua", Georgia, serif;
        background-color: var(--bg-color);
        color: var(--text-color);
        counter-reset: sidenote-counter;
      }

      body {
        width: 87.5%;
        margin-left: auto;
        margin-right: auto;
        padding-left: 12.5%;
        max-width: 1400px;
        line-height: 1.6;
      }

      h1, h2, h3 {
        font-weight: 400;
        margin-top: 4rem;
        margin-bottom: 1.4rem;
      }

      h1 { 
        font-size: 3.2rem; 
        line-height: 1; 
        margin-top: 5rem; 
      }

      h2 { 
        font-size: 2.2rem; 
        line-height: 1; 
      }

      h3 { 
        font-size: 1.7rem; 
      }

      p {
        margin-top: 1.4rem;
        margin-bottom: 1.4rem;
        padding-right: 0;
        vertical-align: baseline;
      }

      a {
        color: var(--accent-color);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .marginnote {
        float: right;
        clear: right;
        margin-right: -60%;
        width: 50%;
        margin-top: 0.3rem;
        margin-bottom: 0;
        font-size: 1.1rem;
        line-height: 1.3;
        vertical-align: baseline;
        position: relative;
      }

      .template-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
      }

      .template-card {
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1.5rem;
        background: var(--bg-color);
        box-shadow: 0 2px 8px var(--shadow-color);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .template-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px var(--shadow-color);
      }

      .template-card h3 {
        margin-top: 0;
        margin-bottom: 1rem;
        font-size: 1.4rem;
      }

      .template-meta {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: 1rem;
      }

      .template-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .tag {
        background: var(--code-bg);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.8rem;
        border: 1px solid var(--border-color);
      }

      .filters {
        background: var(--code-bg);
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        border: 1px solid var(--border-color);
      }

      .filter-row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
      }

      .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .filter-group label {
        font-size: 0.9rem;
        font-weight: 600;
      }

      .filter-group input,
      .filter-group select {
        padding: 0.5rem;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        background: var(--bg-color);
        color: var(--text-color);
      }

      .favorites-toggle {
        background: var(--accent-color);
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
      }

      .favorites-toggle:hover {
        opacity: 0.9;
      }

      .favorites-toggle.active {
        background: #28a745;
      }

      @media (max-width: 760px) {
        body {
          width: 90%;
          padding-left: 5%;
          padding-right: 5%;
        }
        
        .marginnote {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
