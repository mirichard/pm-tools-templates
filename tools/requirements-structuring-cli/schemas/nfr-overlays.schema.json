{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "taxonomyRevision",
    "releaseStatus",
    "overlays"
  ],
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "taxonomyRevision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "releaseStatus": {
      "const": "requires-human-verification"
    },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "applicability",
          "patterns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "string",
            "minLength": 1
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "nfr-patterns.schema.json#/definitions/pattern"
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nfr-overlays.schema.json",
  "title": "Additive opt-in NFR overlay review candidates"
}
